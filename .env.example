# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 启动：./run-dev.sh（会自动 source .env）

# ── Agent 执行（跑真 agent 时需要）──────────────────────────
# 方式 A：直连 Anthropic 官方
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 方式 B：第三方/代理端点（如 GLM 等 Anthropic 兼容服务）—— 注释掉 A，改用：
# ANTHROPIC_AUTH_TOKEN=你的token
# ANTHROPIC_BASE_URL=https://你的兼容端点

# 可选：容器内访问 Anthropic 需要代理时（国内常用）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── GitHub 集成（导入已有仓库时需要）────────────────────────
# GitHub PAT（classic）：需要 repo 权限；或 fine-grained：contents:write + pull-requests:write
GITHUB_TOKEN=ghp_xxxxxxxx

# ── 登录（单用户密码门）─────────────────────────────────────
# 登录密码（单用户，无用户名）。启动 server 必填，缺则 fatal。
INFERA_PASSWORD=

# ── MCP 服务（claude/codex 等外部 agent 驾驶流水线）──────────
# 专用 Bearer token；不设置 = /mcp 端点禁用。用法与工具说明见 docs/mcp.md。
# INFERA_MCP_TOKEN=

# ── Agent 可替换（一般不用改）───────────────────────────────
# agent 命令。默认 claude；本地调试可用 `echo`（agent 阶段直接输出该命令结果）；
# 换 agent（如 pi）改这里。
# AGENT_CMD=claude

# agent 执行后端。默认空 = 本地进程；docker = 容器执行（需先构建 AGENT_IMAGE 镜像）。
# AGENT_BACKEND=docker

# ── 后端服务（一般不用改）──────────────────────────────────
# 数据库。默认指向同容器里的 infera_v2（新后端 v1 起全新 schema；
# 旧库 infera 保留 v7 legacy 表仅供查阅，两者互不影响）。
# DATABASE_URL=postgres://infera:infera@localhost:5433/infera_v2?sslmode=disable

# HTTP 端口（8080 与 :8080 写法均可）
# PORT=8080

# unit_test 阶段命令（本地模式）。默认 true（跳过）。
# TEST_CMD=true

# workdir 根目录：intake 即 clone、全程共享、终态延迟清理（默认 30min 后）。
# REPO_WORK_ROOT=/tmp/infera-workdirs

# agent 容器镜像（仅 AGENT_BACKEND=docker 时用）
# AGENT_IMAGE=infera-agent
