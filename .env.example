# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 启动：./run-dev.sh（会自动 source .env）

# ── Agent 执行（P2 smoke 需要）──────────────────────────────
# 方式 A：直连 Anthropic 官方
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 方式 B：第三方/代理端点（如 GLM 等 Anthropic 兼容服务）—— 注释掉 A，改用：
# ANTHROPIC_AUTH_TOKEN=你的token
# ANTHROPIC_BASE_URL=https://你的兼容端点

# 可选：容器内访问 Anthropic 需要代理时（国内常用）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── GitHub 集成（P4 smoke 需要）─────────────────────────────
# GitHub PAT（classic）：需要 repo 权限；或 fine-grained：contents:write + pull-requests:write
GITHUB_TOKEN=ghp_xxxxxxxx

# ── 登录（P7 单用户密码门）──────────────────────────────────
# 登录密码（单用户，无用户名）。启动 server 必填，缺则 fatal。
INFERA_PASSWORD=

# ── 后端服务（一般不用改）──────────────────────────────────
# DATABASE_URL=postgres://infera:infera@localhost:5433/infera?sslmode=disable
# PORT=8080
# AGENT_IMAGE=infera-agent
# REPO_WORK_ROOT=/tmp/infera-repos
