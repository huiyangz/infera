# R11 真实 agent 接入信息模板（编排者填写；即任务书中的「占位环境变量亦可」通道）
#
# 用法：cp r11-agents.env.example r11-agents.env && 填真值 &&
#       set -a; source r11-agents.env; set +a; ./register-real-agents.sh
# 未填的变量 → 脚本退回显式失败占位（cli 以 exit 70 报错 / http 连 127.0.0.1:9 /
# docker 拉不存在的镜像），交付会在对应阶段 blocked，绝不产生可被误读的产物。
# r11-agents.env 已在 .gitignore 忽略范围外，注意不要把凭证提交进仓库。

# ── 冒烟环境 ────────────────────────────────────────────────
INFERA_BASE_URL=http://localhost:18087
INFERA_PASSWORD=
# 省略 = 改全局默认编排；填项目 ID = 只覆盖该项目（推荐，零扰共享环境）
SMOKE_PROJECT_ID=

# ── infCode（生成/设计/任务类节点：spec、code_gen；design/tasks 待平台支持绑定）──
# 形态三选一：cli | http | docker
INFCODE_FORM=cli
# cli 形态：服务器侧 shell 命令。契约：进程 cwd=workdir，环境变量
# INFERA_ROLE / INFERA_WORKDIR / INFERA_PROMPT，prompt 同时写 stdin；
# stdout+stderr 合并即产物；非零退出 = 阶段失败。凭证可直接写进命令前缀（注意明文落库）。
INFCODE_COMMAND=
# http 形态：POST $URL，请求体 {"role","prompt","workdir"}，期待 200 {"output":"..."}。
# 注意：当前 http runner 不支持任何鉴权头——token 只能进 URL 查询串（若产品支持）。
INFCODE_URL=
# docker 形态：一次性容器，workdir 挂载到 /work，prompt 追加为命令最后一个参数；
# 不透传环境变量（role/凭证均不可用，见冒烟报告问题清单）。
INFCODE_IMAGE=
INFCODE_DOCKER_CMD=

# ── testAgent（测试生成节点：test_gen）──────────────────────
TESTAGENT_FORM=cli
TESTAGENT_COMMAND=
TESTAGENT_URL=
TESTAGENT_IMAGE=
TESTAGENT_DOCKER_CMD=

# ── codeReviewAgent（审查节点：code_review 预审 + spec_conformance/code_quality 双道）──
CODEREVIEW_FORM=http
CODEREVIEW_COMMAND=
CODEREVIEW_URL=
CODEREVIEW_IMAGE=
CODEREVIEW_DOCKER_CMD=
