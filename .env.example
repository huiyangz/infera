# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 启动：./run-dev.sh（会自动 source .env）

# ── Agent 执行（跑真 agent 时需要）──────────────────────────
# 方式 A：直连 Anthropic 官方
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 方式 B：第三方/代理端点（如 GLM 等 Anthropic 兼容服务）—— 注释掉 A，改用：
# ANTHROPIC_AUTH_TOKEN=你的token
# ANTHROPIC_BASE_URL=https://你的兼容端点

# 可选：容器内访问 Anthropic 需要代理时（国内常用）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── GitHub 集成（导入已有仓库时需要）────────────────────────
# GitHub PAT（classic）：需要 repo 权限；或 fine-grained：contents:write + pull-requests:write
GITHUB_TOKEN=ghp_xxxxxxxx
# API 入口覆盖（可选，GitHub Enterprise 用；留空 = 官方 api.github.com）
# GITHUB_API_URL=https://github.example.com/api/v3

# ── Multica 接入（infera 作为唯一前台时需要）────────────────
# 需求流转装配（reqservice + 闸门轮询器）的六键：全部留空 = 未接入（需求
# API 返回 503、轮询器不启动）；任一键出现即视为尝试接入，缺项在启动期
# 由构造器显式报错（不静默降级）。语义详见 docs/requirements-flow.md。
# ServerURL 必须显式指向本地实例——指向云端 multica.ai 视为误配，构造期报错。
# MULTICA_SERVER_URL=http://localhost:8088
# 服务 token（mul_* 用户 token；mat_* agent token 同样可用，Bearer 认证）。
# 审批/决策/返工的代发评论、issue 状态轮询、增量评论拉取都以这个身份执行。
# MULTICA_TOKEN=
# MULTICA_WORKSPACE_ID=
# 固定 project：派发创建的 Multica 父 issue 固定归属的项目 id（接入时必填）。
# MULTICA_PROJECT_ID=
# Tech Lead agent id：派发时指派的 agent（接入时必填；指派即置 todo 唤醒）。
# MULTICA_TECH_LEAD_AGENT_ID=
# workspace slug：深链逃生口的工作区段（接入时必填），如 infera——
# 深链形如 {MULTICA_SERVER_URL}/{slug}/issues/{issue-id}。
# MULTICA_WORKSPACE_SLUG=infera

# ── 登录（单用户密码门）─────────────────────────────────────
# 登录密码（单用户，无用户名）。启动 server 必填，缺则 fatal。
INFERA_PASSWORD=

# ── MCP 服务（claude/codex 等外部 agent 驾驶流水线）──────────
# 专用 Bearer token；不设置 = /mcp 端点禁用。用法与工具说明见 docs/mcp.md。
# 本机 helper（infera-link，网页「在本地处理此阶段」按钮）读同名变量，见 helper/README.md。
# INFERA_MCP_TOKEN=

# ── Agent 可替换（一般不用改）───────────────────────────────
# agent 命令。默认 claude；本地调试可用 `echo`（agent 阶段直接输出该命令结果）；
# 换 agent（如 pi）改这里。
# AGENT_CMD=claude

# agent 执行后端。默认空 = 本地进程；docker = 容器执行（需先构建 AGENT_IMAGE 镜像）。
# AGENT_BACKEND=docker

# ── 后端服务（一般不用改）──────────────────────────────────
# 数据库。默认指向同容器里的 infera_v2（新后端 v1 起全新 schema；
# 旧库 infera 保留 v7 legacy 表仅供查阅，两者互不影响）。
# DATABASE_URL=postgres://infera:infera@localhost:5433/infera_v2?sslmode=disable

# HTTP 端口（8080 与 :8080 写法均可）
# PORT=8080

# unit_test 阶段命令（本地模式）。默认 true（跳过）。
# TEST_CMD=true

# workdir 根目录：intake 即 clone、全程共享、终态延迟清理（默认 30min 后）。
# REPO_WORK_ROOT=/tmp/infera-workdirs

# 闸门轮询间隔（Multica 接入时生效）。默认 30s；(0, 60s] 之外报错——
# AC-3 要求父 issue 状态变化 2 分钟内反映，超 60s 的间隔配置期直接挡掉。
# GATE_POLL_INTERVAL=30s

# agent 容器镜像（仅 AGENT_BACKEND=docker 时用）
# AGENT_IMAGE=infera-agent
